# Public browser configuration only. Never put any secret under VITE_.
VITE_DATA_MODE=mock
VITE_CLOUDBASE_ENV_ID=
# Standalone Node server (npm run start:server reads .env).
PORT=8787
# For separate frontend/proxy hosting, use the exact frontend origin, no path:
# ALLOWED_ORIGIN=https://sn0w051201.github.io
# Optional server-owned model key; production also requires a proxy access token.
# LLM_API_KEY=
# PROXY_ACCESS_TOKEN=
# CloudBase function-only options:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# AI_DAILY_LIMIT=10
